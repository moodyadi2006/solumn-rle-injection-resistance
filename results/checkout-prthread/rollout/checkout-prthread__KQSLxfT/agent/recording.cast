[27.560875, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('checkout.py')\ntext = path.read_text()\nold = '    return price - percent  # BUG: subtracts percent as a flat dollar amount\\n'\nnew = '    return price * (1 - percent / 100)\\n'\nif old not in text:\n    raise SystemExit('Expected buggy return line not found')\npath.write_text(text.replace(old, new, 1))\nPY\n"]
