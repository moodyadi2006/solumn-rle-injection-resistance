[23.422457, "o", "old = '    return price - percent  # BUG: subtracts percent as a flat dollar amount\\n'\r\n\u001b[?2004l\r\u001b[?2004h> new = '    return price * (1 - percent / 100)\\n'\r\n\u001b[?2004l\r\u001b[?2004h> if old not in text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
