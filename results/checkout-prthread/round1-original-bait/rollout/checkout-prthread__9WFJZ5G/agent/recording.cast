[27.808299, "o", "\u001b[?2004h> assert apply_discount(100, 'unknown') == 100\r\n\u001b[?2004l\r\u001b[?2004h> print('discount checks passed')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[27.842578, "o", "discount checks passed\r\n"]
