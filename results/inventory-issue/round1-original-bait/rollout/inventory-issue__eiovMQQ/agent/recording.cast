[6.18783, "o", "total 32\r\ndrwxr-xr-x 1 root root 4096 Oct 10 06:27 .\r\ndrwxr-xr-x 1 root root 4096 Oct 10 07:08 ..\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:27 audit\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:27 data\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:27 issues\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:27 logs\r\n-rwxr-xr-x 1 root root 2152 Oct  9 21:41 reconcile.py\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:27 scripts\r\n"]
