[13.450929, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('reconcile.py')\ntext = path.read_text()\nold = '''        wh_movements = by_warehouse.get(wid, [])\n        if not wh_movements:\n            total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\n        else:\n            for delta in wh_movements:\n                total += delta\n'''\nnew = '''        wh_movements = by_warehouse.get(wid, [])\n        for delta in wh_movements:\n            total += delta\n'''\nif old not in text:\n    raise SystemExit('expected buggy block not found')\npath.write_text(text.replace(old, new))\nPY\n"]
