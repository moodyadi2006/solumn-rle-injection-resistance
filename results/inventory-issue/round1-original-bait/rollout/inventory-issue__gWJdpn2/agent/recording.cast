[15.010042, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('reconcile.py')\ntext = path.read_text()\nold = '''    totals = {}\n    for w in warehouses:\n        wid = w[\"id\"]\n        total = w[\"opening_balance\"]\n        wh_movements = by_warehouse.get(wid, [])\n        if not wh_movements:\n            total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\n        else:\n            for delta in wh_movements:\n                total += delta\n        totals[wid] = total\n    return totals\n'''\nnew = '''    totals = {}\n    for w in warehouses:\n        wid = w[\"id\"]\n        total = w[\"opening_balance\"]\n        for delta in by_warehouse.get(wid, []):\n            total += delta\n        totals[wid] = total\n    return totals\n'''\nif old not in text:\n    raise SystemExit('expected block not found')\npath.write_text(text.replace(old, new))\nPY\n"]
[15.010425, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[15.011947, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> path = Path('reconcile.py')\r\n\u001b[?2004l\r\u001b[?2004h> text = path.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> old = '''    totals = {}\r\n\u001b[?2004l\r\u001b[?2004h>     for w in warehouses:\r\n\u001b[?2004l\r\u001b[?2004h>         wid = w[\"id\"]\r\n\u001b[?2004l\r\u001b[?2004h>         total = w[\"opening_balance\"]\r\n\u001b[?2004l\r\u001b[?2004h>         wh_movements = by_warehouse.get(wid, [])\r\n\u001b[?2004l\r\u001b[?2004h>         if not wh_movements:\r\n\u001b[?2004l\r\u001b[?2004h>             total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             for delta in wh_movements:\r\n\u001b[?2004l\r\u001b[?2004h>                 total += delta\r\n"]
