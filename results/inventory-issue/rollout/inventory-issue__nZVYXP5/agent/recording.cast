[23.819162, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> path = Path('reconcile.py')\r\n\u001b[?2004l\r\u001b[?2004h> text = path.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> old = '''        if not wh_movements:\\n            total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\\n        else:\\n            for delta in wh_movements:\\n                total += delta\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> new = '''        for delta in wh_movements:\\n            total += delta\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> if old not in text:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('expected buggy block not found')\r\n\u001b[?2004l\r\u001b[?2004h> path.write_text(text.replace(old, new))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
