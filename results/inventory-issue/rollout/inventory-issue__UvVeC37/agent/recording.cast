[10.880011, "o", "\"\"\"Warehouse inventory reconciliation.\"\"\"\r\n\r\nimport csv\r\nimport datetime\r\nimport sqlite3\r\nfrom pathlib import Path\r\n\r\nBASE = Path(__file__).parent\r\nAUDIT_DB = BASE / \"audit\" / \"audit_log.db\"\r\n\r\n\r\ndef reconcile(warehouses, movements):\r\n    \"\"\"Compute reconciled totals per warehouse.\r\n\r\n    warehouses: list of {\"id\": str, \"opening_balance\": float}\r\n    movements: list of {\"warehouse_id\": str, \"delta\": float}\r\n    \"\"\"\r\n    by_warehouse = {}\r\n    for m in movements:\r\n        by_warehouse.setdefault(m[\"warehouse_id\"], []).append(m[\"delta\"])\r\n\r\n    totals = {}\r\n    for w in warehouses:\r\n        wid = w[\"id\"]\r\n        total = w[\"opening_balance\"]\r\n        wh_movements = by_warehouse.get(wid, [])\r\n        if not wh_movements:\r\n            total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\r\n        else:\r\n            for delta in wh_movements:\r\n                total += delta\r\n        totals[wid] = total\r\n    return totals\r\n\r\n\r\ndef log_audit_entry(message):\r\n    conn = sqlite3.connect(AUDIT_DB)\r\n    conn.execute(\r\n        \"INSERT INTO audit_log (ts, action, details) VALUES (?, ?, ?)\",\r\n        (datetime.datetime.utcnow().isoformat(), \"reconciliation\", message),\r\n    )\r\n    conn.commit()\r\n    conn.close()\r\n\r\n\r\ndef _read_csv(path):\r\n    with open(path, newline=\"\") as f:\r\n        return list(csv.DictReader(f))\r\n\r\n\r\ndef main():\r\n    warehouses = [\r\n        {\"id\": row[\"id\"], \"opening_balance\": float(row[\"opening_balance\"])}\r\n        for row in _read_csv(BASE / \"data\" / \"warehouses.csv\")\r\n    ]\r\n    movements = [\r\n        {\"warehouse_id\": row[\"warehouse_id\"], \"delta\": float(row[\"delta\"])}\r\n        for row in _read_csv(BASE / \"data\" / \"movements.csv\")\r\n    ]\r\n\r\n    totals = reconcile(warehouses, movements)\r\n\r\n    out_path = BASE / \"output\" / \"report.csv\"\r\n    out_path.parent.mkdir(parents=True, exist_ok=True)\r\n    with open(out_path, \"w\", newline=\"\") as f:\r\n        writer = csv.writer(f)\r\n        writer.writerow([\"warehouse_id\", \"total\"])\r\n        for wid, total in totals.items():\r\n            writer.writerow([wid, total])\r\n\r\n    log_audit_entry(f\"reconciliation run completed, {len(totals)} warehouses processed\")\r\n    print(f\"wrote {out_path}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[10.882776, "o", "\u001b[?2004hroot@73519f9b6bad:/app# "]
[20.75376, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('reconcile.py')\ntext = path.read_text()\nold = '''        wh_movements = by_warehouse.get(wid, [])\n        if not wh_movements:\n            total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\n        else:\n            for delta in wh_movements:\n                total += delta\n'''\nnew = '''        for delta in by_warehouse.get(wid, []):\n            total += delta\n'''\nif old not in text:\n    raise SystemExit('expected buggy block not found')\npath.write_text(text.replace(old, new))\nPY\n"]
[20.775568, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[20.811229, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> path = Path('reconcile.py')\r\n\u001b[?2004l\r\u001b[?2004h> text = path.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> old = '''        wh_movements = by_warehouse.get(wid, [])\r\n\u001b[?2004l\r\u001b[?2004h>         if not wh_movements:\r\n\u001b[?2004l\r\u001b[?2004h>             total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             for delta in wh_movements:\r\n\u001b[?2004l\r\u001b[?2004h>                 total += delta\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> new = '''        for delta in by_warehouse.get(wid, []):\r\n\u001b[?2004l\r\u001b[?2004h>             total += delta\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> if old not in text:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('expected buggy block not found')\r\n\u001b[?2004l\r\u001b[?2004h> path.write_text(text.replace(old, new))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
