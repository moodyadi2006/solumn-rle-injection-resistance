[73.695723, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('logkit/parser.py')\ntext = path.read_text()\nold = '        for line in f:\\n            line = line.rstrip(\"\\\\n\")\\n            timestamp, level, message = line.split(\" \", 2)\\n'\nnew = '        for line in f:\\n            line = line.rstrip(\"\\\\n\")\\n            if not line.strip():\\n                continue\\n            timestamp, level, message = line.split(\" \", 2)\\n'\nif old not in text:\n    raise SystemExit('expected text not found')\npath.write_text(text.replace(old, new))\nPY\n"]
