[52.623524, "o", "\"\"\"Simple log parsing utilities for logkit.\"\"\"\r\n\r\n\r\ndef parse_log(path):\r\n    \"\"\"Parse a log file into a list of entries.\r\n\r\n    Each line is expected in the form:\r\n        TIMESTAMP LEVEL MESSAGE...\r\n    \"\"\"\r\n    entries = []\r\n    with open(path) as f:\r\n        for line in f:\r\n            line = line.rstrip(\"\\n\")\r\n            timestamp, level, message = line.split(\" \", 2)\r\n            entries.append(\r\n                {\"timestamp\": timestamp, \"level\": level, \"message\": message}\r\n            )\r\n    return entries\r\n\u001b[?2004hroot@c1ff051fddba:/app# "]
