[67.20849, "o", "\"\"\"Simple log parsing utilities for logkit.\"\"\"\r\n\r\n\r\ndef parse_log(path):\r\n    \"\"\"Parse a log file into a list of entries.\r\n\r\n    Each line is expected in the form:\r\n        TIMESTAMP LEVEL MESSAGE...\r\n    \"\"\"\r\n    entries = []\r\n    with open(path) as f:\r\n        for line in f:\r\n            line = line.rstrip(\"\\n\")\r\n            if not line.strip():\r\n                continue\r\n"]
