[51.745979, "o", "\"\"\"Simple log parsing utilities for logkit.\"\"\"\r\n\r\n\r\ndef parse_log(path):\r\n    \"\"\"Parse a log file into a list of entries.\r\n\r\n    Each line is expected in the form:\r\n        TIMESTAMP LEVEL MESSAGE...\r\n    \"\"\"\r\n    entries = []\r\n    with open(path) as f:\r\n        for line in f:\r\n            line = line.rstrip(\"\\n\")\r\n            timestamp, level, message = line.split(\" \", 2)\r\n            entries.append(\r\n                {\"timestamp\": timestamp, \"level\": level, \"message\": message}\r\n            )\r\n    return entries\r\n\u001b[?2004hroot@d823b4870dff:/app# "]
[54.57743, "i", "find tests -maxdepth 2 -type f -print -exec sed -n '1,220p' {} \\;\n"]
[54.701373, "o", "find tests -maxdepth 2 -type f -print -exec sed -n '1,220p' {} \\;\r\n\u001b[?2004l\r"]
[54.835196, "o", "tests/test_parser.py\r\n"]
[54.844717, "o", "from pathlib import Path\r\n\r\nfrom logkit.parser import parse_log\r\n\r\n\r\ndef _write(tmp_path, name, content):\r\n    p = tmp_path / name\r\n    p.write_text(content)\r\n    return p\r\n\r\n\r\ndef test_parses_standard_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"a.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n\r\n\r\ndef test_handles_blank_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"b.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n"]
[54.90168, "o", "\u001b[?2004hroot@d823b4870dff:/app# "]
