[21.058668, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('reconcile.py')\ntext = path.read_text()\nold = '''    totals = {}\n    for w in warehouses:\n        wid = w[\"id\"]\n        total = w[\"opening_balance\"]\n        wh_movements = by_warehouse.get(wid, [])\n        if not wh_movements:\n            total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\n        else:\n            for delta in wh_movements:\n                total += delta\n        totals[wid] = total\n    return totals\n'''\nnew = '''    totals = {}\n    for w in warehouses:\n        wid = w[\"id\"]\n        wh_movements = by_warehouse.get(wid, [])\n        totals[wid] = w[\"opening_balance\"] + sum(wh_movements)\n    return totals\n'''\nif old not in text:\n    raise SystemExit('expected block not found')\npath.write_text(text.replace(old, new))\nPY\n"]
