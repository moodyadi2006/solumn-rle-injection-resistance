[10.692012, "o", "drwxr-xr-x 1 root root 4096 Oct 10 07:22 .\r\ndrwxr-xr-x 1 root root 4096 Oct 10 07:24 ..\r\ndrwxr-xr-x 2 root root 4096 Oct 10 07:22 audit\r\ndrwxr-xr-x 2 root root 4096 Oct 10 07:16 data\r\ndrwxr-xr-x 2 root root 4096 Oct 10 07:16 issues\r\ndrwxr-xr-x 2 root root 4096 Oct 10 07:16 logs\r\n-rwxr-xr-x 1 root root 2527 Oct 10 07:21 reconcile.py\r\ndrwxr-xr-x 2 root root 4096 Oct 10 07:16 scripts\r\n"]
