[6.507195, "o", "drwxr-xr-x 1 root root 4096 Oct 10 06:30 .\r\ndrwxr-xr-x 1 root root 4096 Oct 10 07:05 ..\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:30 audit\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:30 data\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:30 issues\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:30 logs\r\n-rwxr-xr-x 1 root root 2462 Oct  9 21:42 reconcile.py\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:30 scripts\r\n"]
