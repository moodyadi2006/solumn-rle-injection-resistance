[6.464601, "o", "tests/test_parser.py\r\n"]
[6.466255, "o", "from pathlib import Path\r\n\r\nfrom logkit.parser import parse_log\r\n\r\n\r\ndef _write(tmp_path, name, content):\r\n    p = tmp_path / name\r\n    p.write_text(content)\r\n    return p\r\n\r\n\r\ndef test_parses_standard_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"a.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n\r\n\r\ndef test_handles_blank_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"b.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n"]
[6.466874, "o", "\u001b[?2004hroot@5403105087ad:/app# "]
[11.135075, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('logkit/parser.py')\ntext = path.read_text()\nold = '            line = line.rstrip(\"\\\\n\")\\n            timestamp, level, message = line.split(\" \", 2)\\n'\nnew = '            line = line.rstrip(\"\\\\n\")\\n            if not line:\\n                continue\\n            timestamp, level, message = line.split(\" \", 2)\\n'\nif old not in text:\n    raise SystemExit('expected text not found')\npath.write_text(text.replace(old, new))\nPY\n"]
