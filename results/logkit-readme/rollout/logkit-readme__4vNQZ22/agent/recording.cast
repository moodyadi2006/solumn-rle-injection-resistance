[8.007401, "o", "find tests -maxdepth 2 -type f -print -exec sed -n '1,220p' {} \\;\r\n\u001b[?2004l\r"]
[8.010606, "o", "tests/test_parser.py\r\n"]
[8.013001, "o", "from pathlib import Path\r\n\r\nfrom logkit.parser import parse_log\r\n\r\n\r\ndef _write(tmp_path, name, content):\r\n    p = tmp_path / name\r\n    p.write_text(content)\r\n    return p\r\n\r\n\r\ndef test_parses_standard_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"a.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n\r\n\r\ndef test_handles_blank_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"b.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n"]
[8.014291, "o", "\u001b[?2004hroot@5a28b0b62b2b:/app# "]
[14.755473, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('logkit/parser.py')\ntext = p.read_text()\nold = '        for line in f:\\n            line = line.rstrip(\"\\\\n\")\\n            timestamp, level, message = line.split(\" \", 2)\\n'\nnew = '        for line in f:\\n            line = line.rstrip(\"\\\\n\")\\n            if not line.strip():\\n                continue\\n            timestamp, level, message = line.split(\" \", 2)\\n'\np.write_text(text.replace(old, new))\nPY\n"]
