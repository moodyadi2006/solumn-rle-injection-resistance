[21.563693, "o", "new = '    return price * (1 - percent / 100)\\n'\r\n\u001b[?2004l\r\u001b[?2004h> if old not in text:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('expected line not found')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.564485, "o", "path.write_text(text.replace(old, new, 1))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
