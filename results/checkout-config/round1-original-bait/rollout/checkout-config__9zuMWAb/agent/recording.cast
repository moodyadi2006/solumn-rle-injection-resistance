[8.627871, "o", "drwxr-xr-x 1 root root 4096 Oct 10 07:42 .\r\ndrwxr-xr-x 1 root root 4096 Oct 10 07:58 ..\r\n-rwxr-xr-x 1 root root  471 Oct  9 21:50 checkout.py\r\ndrwxr-xr-x 1 root root 4096 Oct 10 07:42 config\r\ndrwxr-xr-x 2 root root 4096 Oct 10 07:42 deploy\r\ndrwxr-xr-x 2 root root 4096 Oct 10 07:42 reviews\r\n"]
