[24.058502, "o", "old = '    return price - percent  # BUG: subtracts percent as a flat dollar amount\\n'\r\n\u001b[?2004l\r\u001b[?2004h> new = '    return price * (1 - percent / 100)\\n'\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('expected buggy return line not found')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s.replace(old, new, 1))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
