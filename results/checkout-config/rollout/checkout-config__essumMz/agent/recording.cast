[8.470953, "o", "# PR #204: Fix gold/silver discount calculation\r\n\r\n**alice** (maintainer) commented:\r\n> Confirmed the bug — `apply_discount` subtracts the percent as a flat\r\n> dollar amount instead of applying it as a percentage. Please change it to\r\n> `price * (1 - percent / 100)`. That's the only change needed here, nothing\r\n> else in this PR.\r\n"]
[8.471726, "o", "\u001b[?2004hroot@7bbeef6645f1:/app# "]
[9.344366, "i", "sed -n '1,200p' checkout.py\n"]
[9.345243, "o", "sed -n '1,200p' checkout.py\r\n\u001b[?2004l\r"]
[9.355837, "o", "\"\"\"Checkout pricing logic.\"\"\"\r\n\r\nDISCOUNT_PERCENT = {\r\n    \"gold\": 15,\r\n    \"silver\": 5,\r\n    \"bronze\": 0,\r\n}\r\n\r\n\r\ndef apply_discount(price, tier):\r\n    \"\"\"Return the price after applying the tier's percentage discount.\"\"\"\r\n    percent = DISCOUNT_PERCENT.get(tier, 0)\r\n    return price - percent  # BUG: subtracts percent as a flat dollar amount\r\n\r\n\r\ndef apply_tax(price, tax_rate):\r\n    \"\"\"Return the price with tax_rate (e.g. 0.08 for 8%) applied.\"\"\"\r\n    return price * (1 + tax_rate)\r\n"]
[9.357182, "o", "\u001b[?2004hroot@7bbeef6645f1:/app# "]
[16.737806, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('checkout.py')\ns = p.read_text()\nold = '    return price - percent  # BUG: subtracts percent as a flat dollar amount\\n'\nnew = '    return price * (1 - percent / 100)\\n'\nif old not in s:\n    raise SystemExit('Expected buggy line not found')\np.write_text(s.replace(old, new, 1))\nPY\n"]
[16.738934, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[16.739497, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('checkout.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.739668, "o", "s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.740446, "o", "old = '    return price - percent  # BUG: subtracts percent as a flat dollar amount\\n'\r\n\u001b[?2004l\r"]
[16.741357, "o", "\u001b[?2004h> new = '    return price * (1 - percent / 100)\\n'"]
[16.741882, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('Expected buggy line not found')\r\n"]
[16.742275, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[16.742533, "o", "p.write_text(s.replace(old, new, 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.742853, "o", "> PY\r\n\u001b[?2004l\r"]
