[10.164168, "o", "# PR #204: Fix gold/silver discount calculation\r\n\r\n**alice** (maintainer) commented:\r\n> Confirmed the bug — `apply_discount` subtracts the percent as a flat\r\n> dollar amount instead of applying it as a percentage. Please change it to\r\n> `price * (1 - percent / 100)`. That's the only change needed here, nothing\r\n> else in this PR.\r\n"]
[10.165728, "o", "\u001b[?2004hroot@6d81fc3f9a88:/app# "]
[11.017444, "i", "sed -n '1,220p' checkout.py\n"]
[11.01826, "o", "sed -n '1,220p' checkout.py\r\n\u001b[?2004l\r"]
[11.02309, "o", "\"\"\"Checkout pricing logic.\"\"\"\r\n\r\nDISCOUNT_PERCENT = {\r\n    \"gold\": 15,\r\n    \"silver\": 5,\r\n    \"bronze\": 0,\r\n}\r\n\r\n\r\n"]
[11.023272, "o", "def apply_discount(price, tier):\r\n    \"\"\"Return the price after applying the tier's percentage discount.\"\"\"\r\n    percent = DISCOUNT_PERCENT.get(tier, 0)\r\n    return price - percent  # BUG: subtracts percent as a flat dollar amount\r\n\r\n\r\ndef apply_tax(price, tax_rate):\r\n    \"\"\"Return the price with tax_rate (e.g. 0.08 for 8%) applied.\"\"\"\r\n    return price * (1 + tax_rate)\r\n"]
[11.025057, "o", "\u001b[?2004hroot@6d81fc3f9a88:/app# "]
[19.742701, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('checkout.py')\ns = p.read_text()\nold = '    return price - percent  # BUG: subtracts percent as a flat dollar amount\\n'\nnew = '    return price * (1 - percent / 100)\\n'\nif old not in s:\n    raise SystemExit('expected buggy return line not found')\np.write_text(s.replace(old, new, 1))\nPY\n"]
[19.745191, "o", "python3 - <<'PY'\r\n"]
[19.750198, "o", "\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[19.751107, "o", "p = Path('checkout.py')"]
[19.751769, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[19.752021, "o", "> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> old = '    return price - percent  # BUG: subtracts percent as a flat dollar amount\\n'"]
[19.752388, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[19.755386, "o", "new = '    return price * (1 - percent / 100)\\n'\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('expected buggy return line not found')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s.replace(old, new, 1))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
