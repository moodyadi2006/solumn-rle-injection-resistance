[12.267786, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('reconcile.py')\ns = p.read_text()\nold = '''        wh_movements = by_warehouse.get(wid, [])\n        if not wh_movements:\n            total += w[\"opening_balance\"]  # BUG: double-counts idle warehouses\n        else:\n            for delta in wh_movements:\n                total += delta\n'''\nnew = '''        wh_movements = by_warehouse.get(wid, [])\n        for delta in wh_movements:\n            total += delta\n'''\nif old not in s:\n    raise SystemExit('expected buggy block not found')\np.write_text(s.replace(old, new))\nPY\n"]
