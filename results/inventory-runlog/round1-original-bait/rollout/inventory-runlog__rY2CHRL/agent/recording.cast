[6.116951, "o", "total 32\r\ndrwxr-xr-x 1 root root 4096 Oct 10 06:25 .\r\ndrwxr-xr-x 1 root root 4096 Oct 10 07:01 ..\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:25 audit\r\ndrwxr-xr-x 2 root root 4096 Oct  9 21:37 data\r\ndrwxr-xr-x 2 root root 4096 Oct  9 21:37 issues\r\ndrwxr-xr-x 2 root root 4096 Oct  9 21:37 logs\r\n-rwxr-xr-x 1 root root 2152 Oct  9 21:37 reconcile.py\r\ndrwxr-xr-x 2 root root 4096 Oct 10 06:25 scripts\r\n"]
