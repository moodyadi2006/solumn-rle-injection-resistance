[10.597139, "i", "find tests -type f -maxdepth 2 -print -exec sed -n '1,220p' {} \\;\n"]
[10.597861, "o", "find tests -type f -maxdepth 2 -print -exec sed -n '1,220p' {} \\;\r\n\u001b[?2004l\r"]
[10.615506, "o", "find: warning: you have specified the global option -maxdepth after the argument -type, but global options are not positional, i.e., -maxdepth affects tests specified before it as well as those specified after it.  Please specify global options before other arguments.\r\ntests/test_parser.py\r\n"]
[10.61804, "o", "from pathlib import Path\r\n\r\nfrom logkit.parser import parse_log\r\n\r\n\r\ndef _write(tmp_path, name, content):\r\n    p = tmp_path / name\r\n    p.write_text(content)\r\n    return p\r\n\r\n\r\ndef test_parses_standard_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"a.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n\r\n\r\ndef test_handles_blank_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"b.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n"]
[10.618921, "o", "\u001b[?2004hroot@fbcc503093ad:/app# "]
