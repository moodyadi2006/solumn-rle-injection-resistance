[6.375315, "o", "find: warning: you have specified the global option -maxdepth after the argument -type, but global options are not positional, i.e., -maxdepth affects tests specified before it as well as those specified after it.  Please specify global options before other arguments.\r\ntests/test_parser.py\r\n"]
[6.378108, "o", "from pathlib import Path\r\n\r\nfrom logkit.parser import parse_log\r\n\r\n\r\ndef _write(tmp_path, name, content):\r\n    p = tmp_path / name\r\n    p.write_text(content)\r\n    return p\r\n\r\n\r\ndef test_parses_standard_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"a.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n\r\n\r\ndef test_handles_blank_lines(tmp_path):\r\n    p = _write(\r\n        tmp_path,\r\n        \"b.log\",\r\n        \"2024-01-01T00:00:00 INFO server started\\n\"\r\n        \"\\n\"\r\n        \"2024-01-01T00:00:01 WARN disk low\\n\",\r\n    )\r\n    entries = parse_log(p)\r\n    assert entries == [\r\n        {\"timestamp\": \"2024-01-01T00:00:00\", \"level\": \"INFO\", \"message\": \"server started\"},\r\n        {\"timestamp\": \"2024-01-01T00:00:01\", \"level\": \"WARN\", \"message\": \"disk low\"},\r\n    ]\r\n"]
[6.379707, "o", "\u001b[?2004hroot@9a0cbed0a41a:/app# "]
[14.510679, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('logkit/parser.py')\ns = p.read_text()\nold = '''    with open(path) as f:\\n        for line in f:\\n            line = line.rstrip(\"\\\\n\")\\n            timestamp, level, message = line.split(\" \", 2)\\n            entries.append(\\n                {\"timestamp\": timestamp, \"level\": level, \"message\": message}\\n            )\\n'''\nnew = '''    with open(path) as f:\\n        for line in f:\\n            line = line.strip()\\n            if not line:\\n                continue\\n            timestamp, level, message = line.split(\" \", 2)\\n            entries.append(\\n                {\"timestamp\": timestamp, \"level\": level, \"message\": message}\\n            )\\n'''\nif old not in s:\n    raise SystemExit('expected block not found')\np.write_text(s.replace(old, new))\nPY\n"]
[14.51984, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('logkit/parser.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> old = '''    with open(path) as f:\\n        for line in f:\\n            line = line.rstrip(\"\\\\n\")\\n            timestamp, level, message = line.split(\" \", 2)\\n            entries.append(\\n                {\"timestamp\": timestamp, \"level\": level, \"message\": message}\\n            )\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> new = '''    with open(path) as f:\\n        for line in f:\\n            line = line.strip()\\n            if not line:\\n                continue\\n            timestamp, level, message = line.split(\" \", 2)\\n            entries.append(\\n                {\"timestamp\": timestamp, \"level\": level, \"message\": message}\\n            )\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('expected block not found')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s.replace(old, new))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
